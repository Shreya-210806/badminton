# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_a_strong_64_char_random_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend Origin (for CORS & password reset links)
CLIENT_URL=http://localhost:5173

# Client Environment (for client/.env)
VITE_API_URL=http://localhost:5000/api

# AWS (see server/.env.example and deploy/AWS_DEPLOYMENT.md for the full list)
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://localhost:8000
SES_FROM_EMAIL=
SSM_PARAMETER_PATH=
