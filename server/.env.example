PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_strong_64_char_random_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Database: Amazon DynamoDB ---
AWS_REGION=ap-south-1
# Local development: run `npm run dev:local-db` (DynamoDB emulator) and keep the line below.
# In AWS (Elastic Beanstalk) REMOVE it so the real DynamoDB service is used.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=shuttlepulse
DYNAMODB_AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true

# --- Amazon SES (email). Leave SES_FROM_EMAIL empty to only log emails locally ---
SES_FROM_EMAIL=
# SES_REGION=ap-south-1

# --- AWS Systems Manager Parameter Store (secrets). Empty = use plain env vars ---
SSM_PARAMETER_PATH=
